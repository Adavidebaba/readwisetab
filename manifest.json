{
  "manifest_version": 3,
  "name": "Readwise New Tab Quotes",
  "version": "1.2.0",
  "description": "Mostra una citazione casuale da Readwise ogni volta che apri un nuovo tab. Evidenzia testo su qualsiasi pagina per salvarlo su Readwise.",
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://readwise.io/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["highlight-content-script.js"],
      "css": ["highlight-content-style.css"]
    }
  ]
}
